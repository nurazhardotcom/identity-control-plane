{:paths ["src"]
 :deps
 {org.clojure/clojure {:mvn/version "1.12.3"}}
 :aliases
 {:test
  {:extra-paths ["test"]
   :main-opts ["-m" "control-plane.test-runner"]}
  :cljs-test
  {:extra-paths ["test"]
   :deps {org.clojure/clojurescript {:mvn/version "1.12.145"}}
   :main-opts ["-m" "cljs.main"
               "--target" "node"
               "--output-dir" "target/cljs-test"
               "--output-to" "target/cljs-test.js"
               "-m" "control-plane.webcrypto-test"]}}}
